# Copy to app/.env and replace every placeholder before starting Docker Compose.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Optional second source: request a Switzerland-specific key at https://ch.jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://ch.jooble.org/api
JOOBLE_LOCATION=Switzerland
# Keep this list short: Jooble's free API quota is limited.
JOOBLE_SEARCH_TERMS=junior developer,junior software engineer,trainee

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_a_long_random_secret

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=swiss
DATABASE_URL=postgresql://postgres:replace_with_a_strong_database_password@db:5432/swiss

# Optional comma-separated skill filter, e.g. java,spring,python
# STACK_FOCUS=java,spring

# Skills used to estimate job compatibility (comma-separated).
PROFILE_SKILLS=java,spring,python,sql,postgresql,docker,aws,azure,typescript,react,git

# Language levels used by the match estimator.
PROFILE_LANGUAGES=spanish:NATIVE,english:C1,french:B1,german:A1
# Professional experience years to compare against explicit job requirements.
PROFILE_EXPERIENCE_YEARS=0
