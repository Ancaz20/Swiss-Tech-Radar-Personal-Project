# Copy this file to ".env" and fill the values. Do NOT commit your .env file.

# Adzuna API credentials (required to run ingest.py)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Flask secret key
FLASK_SECRET_KEY=change_me_to_a_secure_value

# Database (Postgres) URL — used by the app if set. Default points to the compose DB.
# Example: postgresql://postgres:example@db:5432/swiss
DATABASE_URL=postgresql://postgres:example@db:5432/swiss

# Postgres defaults (used by docker-compose if not overridden)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=swiss
